VITE_APP_NAME=Routekeeper
# Local: http://localhost:8080   Deployed: `cd infra && tofu output -raw api_url`
VITE_API_BASE_URL=http://localhost:8080

# Firebase web config: `cd infra && tofu output firebase_web_config`
# (or Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id-photos
VITE_FIREBASE_APP_ID=

# IANA timezone used for dates, the daily trip boundary and photo stamps
VITE_TIMEZONE=UTC
# Initial map view (lng,lat) and optional pan limit (minLng,minLat,maxLng,maxLat)
VITE_MAP_CENTER=-0.1276,51.5072
VITE_MAP_BOUNDS=
